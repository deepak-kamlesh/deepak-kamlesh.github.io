source "https://rubygems.org"

# Force modern core dependencies
gem "jekyll", "~> 4.3.3"
gem "minimal-mistakes-jekyll", "~> 4.24.0"
gem "webrick", "~> 1.8"

# Group essential building plugins together
group :jekyll_plugins do
  gem "jekyll-paginate"
  gem "jekyll-sitemap"
  gem "jekyll-gist"
  gem "jekyll-feed"
  gem "jekyll-include-cache"
end
